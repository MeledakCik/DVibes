# ---------------------------------------------------------------------------
# DVibes environment
# Copy this file to `.env.local` (Next.js) and/or `.env` (yt-dlp server).
# Every value below is optional: sane defaults are built into the app.
# ---------------------------------------------------------------------------

# Comma-separated Piped API instances. They are tried in order (5s timeout).
NEXT_PUBLIC_PIPED_INSTANCES=https://pipedapi.kavin.rocks,https://pipedapi-libre.kavin.rocks,https://pipedapi.ducks.party,https://api.piped.private.coffee

# Server-only alias (takes precedence on the server). Keep the same list.
PIPED_INSTANCES=

# Comma-separated Invidious API instances. Also loaded from
# lib/api/invidious-instances.json if this variable is empty.
INVIDIOUS_INSTANCES=https://inv.nadeko.net,https://invidious.nerdvpn.de,https://iv.ggtyler.dev

# Small Express/yt-dlp sidecar used as the final fallback layer.
YTDLP_BACKEND_URL=http://127.0.0.1:8787
YTDLP_PORT=8787

# Optional explicit path to a yt-dlp binary. If empty the server looks in
# server/bin, then PATH, then downloads a static build automatically.
YTDLP_PATH=

# Set to false to disable automatic yt-dlp binary download.
YTDLP_AUTO_DOWNLOAD=true

# Extra yt-dlp arguments, e.g. --cookies-from-browser chrome
# YTDLP_EXTRA_ARGS=--cookies-from-browser chrome

# Trending region (ISO 3166-1 alpha-2).
TRENDING_REGION=US

# Optional home-feed search seed. This is a query, not a bundled track list.
DISCOVER_QUERY=music
