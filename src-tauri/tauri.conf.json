{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DVibes",
  "version": "4.2.0",
  "identifier": "com.dvibes.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "DVibes — Your Midnight Music Space",
        "width": 1380,
        "height": 860,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "backgroundColor": "#08080b"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$APPDATA/offline/**", "$APPDATA/stream_cache/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "copyright": "Copyright © 2026 DVibes",
    "shortDescription": "DVibes — Your Midnight Music Space",
    "longDescription": "Music player with synced lyrics, local MP3/FLAC/LRC import, ambient soundscapes, and full offline mode for Windows, macOS, Android and iOS.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "compression": "lzma" }
    },
    "macOS": { "minimumSystemVersion": "10.15" },
    "iOS": { "minimumSystemVersion": "14.0" },
    "android": { "minSdkVersion": 24 }
  }
}
